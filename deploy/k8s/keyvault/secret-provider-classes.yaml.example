# Copy this file outside the repository, replace every placeholder, and apply it
# before the workload. Do not use secretObjects: the application reads CSI files
# directly and no Key Vault value may be synchronized into a Kubernetes Secret.
apiVersion: secrets-store.csi.k8s.io/v1
kind: SecretProviderClass
metadata:
  name: ghcp-runtime-keyvault
spec:
  provider: azure
  parameters:
    clientID: "<runtime-workload-identity-client-id>"
    keyvaultName: "<key-vault-name>"
    tenantId: "<tenant-id>"
    objects: |
      array:
        - |
          objectName: ghcp-admin-token
          objectType: secret
          objectAlias: admin-token
        - |
          objectName: ghcp-postgres-dsn
          objectType: secret
          objectAlias: postgres-dsn
        - |
          objectName: ghcp-redis-password
          objectType: secret
          objectAlias: redis-password
        - |
          objectName: ghcp-credential-master-key
          objectType: secret
          objectAlias: credential-master-key
---
apiVersion: secrets-store.csi.k8s.io/v1
kind: SecretProviderClass
metadata:
  name: ghcp-org-sync-keyvault
spec:
  provider: azure
  parameters:
    clientID: "<org-sync-workload-identity-client-id>"
    keyvaultName: "<key-vault-name>"
    tenantId: "<tenant-id>"
    objects: |
      array:
        - |
          objectName: ghcp-github-token
          objectType: secret
          objectAlias: github-token
---
apiVersion: secrets-store.csi.k8s.io/v1
kind: SecretProviderClass
metadata:
  name: ghcp-migration-keyvault
spec:
  provider: azure
  parameters:
    clientID: "<migration-workload-identity-client-id>"
    keyvaultName: "<key-vault-name>"
    tenantId: "<tenant-id>"
    objects: |
      array:
        - |
          objectName: ghcp-migration-postgres-dsn
          objectType: secret
          objectAlias: postgres-dsn